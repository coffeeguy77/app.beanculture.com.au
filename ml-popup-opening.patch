+  if (loc && loc.type === 'popup' && loc.startDate) {
+    const L = locationsLib();
+    try { if (L && L.popupState(loc, td.full) === 'upcoming') { popupUpcoming = true; popupStart = loc.startDate; } } catch {}
+  }
+
