-          <img src={imgUrl(config.storePhoto, 1600)} alt={config.storeName || 'Our café'} loading="eager" decoding="async" />
+          <img src={imgUrl(storePhoto, 1600)} alt={storeName || 'Our café'} loading="eager" decoding="async" />
