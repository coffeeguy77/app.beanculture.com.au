# ── Square credentials ───────────────────────────────────────────────────────
# Set these in Railway's "Variables" tab (NOT in code, NOT committed to git).
# The access token can move real money — treat it like a password.

# 'production' for your live cafe, 'sandbox' for testing with fake cards.
SQUARE_ENV=production

# Server-side secret. Square Developer dashboard → your app → Credentials.
SQUARE_ACCESS_TOKEN=

# Public app id (starts with sq0idp- in production). Used by the browser too.
SQUARE_APPLICATION_ID=

# The Bean Culture location id. Square dashboard → Locations, or /v2/locations.
SQUARE_LOCATION_ID=

# Currency for order totals / payments.
SQUARE_CURRENCY=AUD

# How dine-in orders are fulfilled: PICKUP (works everywhere) or IN_STORE
# (only if you're accepted into Square's IN_STORE beta).
SQUARE_DINEIN_FULFILLMENT=PICKUP

# Optional: pin the Square API version, and menu cache lifetime (ms).
# SQUARE_VERSION=2025-04-16
# MENU_TTL_MS=60000

# Port is provided by Railway automatically; only set locally if you want.
# PORT=8080
