# ─────────────────────────────────────────────────────────────────────────────
# Bean Culture ordering app — environment variables (set these in Railway)
# ─────────────────────────────────────────────────────────────────────────────

# Square environment + credentials (the access token can move real money).
SQUARE_ENV=production                 # 'production' or 'sandbox'
SQUARE_ACCESS_TOKEN=                   # server secret — Developer dashboard → Credentials
SQUARE_APPLICATION_ID=                 # production starts sq0idp- (used by the browser too)
SQUARE_LOCATION_ID=                    # the Bean Culture location id
SQUARE_CURRENCY=AUD

# Menu structure: only show child categories of this master category.
# Matches "APP" or "APPs" automatically. The "APP" prefix is stripped for display.
SQUARE_PARENT_CATEGORY=APPs
# Fallback allowlist (only used if the parent category above isn't found):
# SQUARE_MENU_CATEGORIES=COFFEE, TEA, COLD DRINKS, ALL DAY MENU, GRAB AND GO

# Dine-in fulfillment: PICKUP (works everywhere) or IN_STORE (needs Square beta).
SQUARE_DINEIN_FULFILLMENT=PICKUP

# Reservation ticket printing: Square's printer routing generally only
# auto-prints items that belong to a routed print category. Reservations are
# created as a $0 order with an ad-hoc "Table reservation" line item, which has
# no category and can silently fail to print even though the order is fine in
# Square. Fix: create a real, $0-priced "Table Reservation" catalog item in
# Square, assign it to a category that's routed to your receipt/kitchen
# printer, then paste its VARIATION id here — reservations will use it instead
# of the ad-hoc line item so tickets print reliably.
# SQUARE_RESERVATION_VARIATION_ID=

# Hours / ordering control
PREORDER_ENABLED=false                 # true = accept orders while closed (as pre-orders)
ORDERING_DISABLED=false                # true = hard stop all ordering (emergency off)

# Test/comp coupon — REMOVE before opening to the public.
# When set, entering this code at checkout zeroes the order (no card charged).
COMP_COUPON_CODE=

# Admin/merchant portal passcode (protects /admin). Leave blank to allow open access.
ADMIN_PASSCODE=

# Live storefront settings override (theme, hero slides, announcement). JSON blob.
# Edit via the /admin page (it exports this), then paste here to publish.
# SETTINGS_JSON={"announcement":"Public holiday hours today","hero":[...]}

# Menu cache lifetime in ms (how fast Square changes appear). Default 45s.
# MENU_TTL_MS=45000

# PORT is provided by Railway automatically.
