+  const doneRecent = tickets.filter((t) => inZone(t) && statusIn(t, zone) === 'done')
     .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)).slice(0, 8);
 
   // All-day counts for the current zone's active tickets
