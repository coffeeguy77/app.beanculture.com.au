From e2d1e94d07b2757bb5026964d669a9d07c0c67cf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 30 Aug 2026 02:15:38 +0000
Subject: [PATCH] Store selector + weather chip: use theme surface tokens so
 they stay readable on dark themes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The header store selector and weather chip hardcoded a white (--card fallback)
background while taking their text colour from the theme's --ink token. On a
dark storefront theme that yielded light text on a near-invisible/white pill —
unreadable. Switch both to the matched --s-card / --s-ink / --s-ink2 / --s-line
token pair the rest of the storefront uses (same as the checkout card), plus a
soft --shadow-sm, so they read correctly on light and dark themes alike and
follow the selected theme.
---
 client/src/styles.css | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/client/src/styles.css b/client/src/styles.css
index f685d1e..731e028 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -1637,16 +1637,16 @@ body:has(.store-shell) { background: #F7F4EF; }
 }
 .store-chip {
   display: inline-flex; align-items: center; gap: 10px;
-  border: 1.5px solid var(--line, #e7ddd2); background: var(--card, #fff);
-  color: var(--ink, #2a1620); border-radius: 999px; padding: 8px 16px;
-  font: inherit; text-align: left;
+  border: 1.5px solid var(--s-line, #e7ddd2); background: var(--s-card, #fff);
+  color: var(--s-ink, #2a1620); border-radius: 999px; padding: 8px 16px;
+  font: inherit; text-align: left; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,.05));
 }
 .store-chip.switchable { cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease; }
-.store-chip.switchable:hover { border-color: var(--brand, #b5566e); box-shadow: 0 2px 10px rgba(0,0,0,.06); }
+.store-chip.switchable:hover { border-color: var(--brand, #b5566e); box-shadow: 0 2px 12px rgba(0,0,0,.12); }
 .store-chip-icon { display: inline-flex; color: var(--brand, #b5566e); flex: none; }
 .store-chip-text { display: inline-flex; flex-direction: column; line-height: 1.1; min-width: 0; }
-.store-chip-label { font-size: 11px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--muted, #8a7a80); }
-.store-chip-name { font-size: 17px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.store-chip-label { font-size: 11px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--s-ink2, #8a7a80); }
+.store-chip-name { font-size: 17px; font-weight: 700; color: var(--s-ink, #2a1620); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .store-chip-change { display: inline-flex; align-items: center; gap: 2px; margin-left: 6px; font-size: 13px; font-weight: 600; color: var(--brand, #b5566e); flex: none; }
 .store-chip-caret { font-size: 11px; }
 @media (max-width: 600px) { .store-chip-name { font-size: 15px; } .store-chip-label { font-size: 10px; } }
@@ -1669,9 +1669,9 @@ body:has(.store-shell) { background: #F7F4EF; }
 .hours-inner-wx > :first-child { min-width: 0; }
 .wx-chip {
   display: inline-flex; align-items: center; gap: 7px; flex: none;
-  border: 1.5px solid var(--line, #e7ddd2); background: var(--card, #fff);
-  border-radius: 999px; padding: 8px 15px;
-  font-size: 16px; font-weight: 700; color: var(--ink, #2a1620); white-space: nowrap;
+  border: 1.5px solid var(--s-line, #e7ddd2); background: var(--s-card, #fff);
+  border-radius: 999px; padding: 8px 15px; box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,.05));
+  font-size: 16px; font-weight: 700; color: var(--s-ink, #2a1620); white-space: nowrap;
 }
 .wx-chip svg { color: var(--brand, #b5566e); flex: none; }
 .wx-chip .wx-temp { line-height: 1; }
-- 
