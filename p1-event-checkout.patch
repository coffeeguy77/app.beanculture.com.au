+      )}
 
       {(isSchedule || isRepeat) && !user?.customerId && (
         <p className="error-text" style={{ fontSize: 13 }}>Sign in from the Account tab to schedule or repeat an order.</p>
       )}
 
-      {loyalty?.active && loyalty.tiers?.length > 0 && when === 'asap' && (
