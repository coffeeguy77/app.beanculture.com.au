 client/src/components/Checkout.jsx | 28 ++++++++++++++++++++++------
 server/index.js                    |  6 +++++-
 server/lib/locations.js            | 13 ++++++++++++-
 server/lib/orders.js               | 10 +++++++---
 5 files changed, 61 insertions(+), 12 deletions(-)

